# Public authentication configuration.
# Copy this file to .env.local (already excluded from Git).
# Supabase dashboard > select project > Connect: Project URL.
# Example shape: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase dashboard > select project > Settings > API Keys > Publishable key.
# Expected key type: sb_publishable_... (NOT sb_secret_... or service_role).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Restart the application after changing environment values.
# Server-only: Supabase project Settings > API Keys > Secret keys.
# Use the existing sb_secret_... key. Never use a NEXT_PUBLIC_ prefix here.
SUPABASE_SECRET_KEY=
# Optional AI feature. Off by default, even if a key is present.
AI_ENABLED=false
# Optional server-only key, required only when AI_ENABLED=true.
OPENAI_API_KEY=
# Central model configuration; pin a provisioned Astra snapshot here when available.
OPENAI_SETUP_MODEL=gpt-6-astra
OPENAI_SETUP_REASONING=high
OPENAI_SETUP_DEEP_REVIEW=true
# Restart after changes. Never paste secrets into chat or commit .env.local.
